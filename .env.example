# Environment variables for the Agentic SDLC Pipeline
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control  -  it is gitignored.

# ---------- Sync Engine ----------
DOCS_ROOT=docs
SRC_ROOT=src/sync_engine
SCRIPTS_DIR=scripts
SYNC_REPORT_OUTPUT=artifacts/sync-report.md
LOG_LEVEL=INFO
DEFAULT_BASE_REF=HEAD~1
DEFAULT_HEAD_REF=HEAD

# ---------- Confluence ----------
CONFLUENCE_PAGE_ID=your_page_id_here
CONFLUENCE_SPACE_KEY=your_space_key_here

# ---------- JIRA ----------
JIRA_STORY_KEY=EPMCDMETST-XXXXX
JIRA_PROJECT_KEY=EPMCDMETST
